{
  "github_token": {
    "description": "GitHub fine-grained PAT（Contents 读写，仅限博客仓库）",
    "type": "string",
    "default": ""
  },
  "github_repo": {
    "description": "博客仓库 owner/repo",
    "type": "string",
    "default": "tianshihao2003/dumplingandcakeblog"
  },
  "github_branch": {
    "description": "目标分支",
    "type": "string",
    "default": "main"
  },
  "imgbed_upload_url": {
    "description": "图床上传地址",
    "type": "string",
    "default": "https://img.tsh520.cn/upload"
  },
  "imgbed_token": {
    "description": "图床 API_TOKEN",
    "type": "string",
    "default": ""
  },
  "imgbed_upload_folder": {
    "description": "图片上传目录（动态/笔记/足迹照片统一上传到此目录，如 blog/moments）",
    "type": "string",
    "default": "blog/moments"
  },
  "album_folder_prefix": {
    "description": "相册图片上传目录前缀（实际目录 = 前缀 + 相册名，与博客相册图床化惯例一致）",
    "type": "string",
    "default": "blog/album"
  },
  "wx_cdn_base_url": {
    "description": "微信媒体 CDN 地址（图片下载异常时兜底用；通常无需修改）",
    "type": "string",
    "default": "https://novac2c.cdn.weixin.qq.com/c2c"
  },
  "amap_key": {
    "description": "高德 Web 服务 Key（足迹坐标用；留空时读取环境变量 AMAP_KEY）",
    "type": "string",
    "default": ""
  },
  "moment_tags": {
    "description": "动态默认标签",
    "type": "list",
    "default": ["日常"]
  },
  "place_tags": {
    "description": "足迹默认标签",
    "type": "list",
    "default": ["旅游"]
  },
  "default_note_dir": {
    "description": "笔记默认分类目录",
    "type": "string",
    "default": "日常随笔"
  },
  "friend_default_avatar": {
    "description": "友链默认头像（未提供头像链接时使用）",
    "type": "string",
    "default": "/assets/ziyuan/tx.webp"
  },
  "friend_tags": {
    "description": "友链默认标签",
    "type": "list",
    "default": ["Blog"]
  },
  "allow_users": {
    "description": "允许使用的用户 ID 列表（个人微信为 wxid）；空列表 = 全部拒绝",
    "type": "list",
    "default": []
  },
  "bill_default_account": {
    "description": "账单默认账户",
    "type": "string",
    "default": "微信"
  },
  "bill_default_category": {
    "description": "账单默认分类",
    "type": "string",
    "default": "其他"
  },
  "schedule_default_priority": {
    "description": "日程默认优先级",
    "type": "string",
    "default": "none"
  },
  "schedule_remind_before": {
    "description": "日程默认提前提醒分钟（0=准点）",
    "type": "int",
    "default": 10
  },
  "enable_ai_bill_schedule": {
    "description": "启用 AI 自然语言记账/日程（关闭则仅正则）",
    "type": "bool",
    "default": true
  },
  "ai_api_key": {
    "description": "AI API Key（为空则用全局 LLM；opencodego 的 Key 填这里）",
    "type": "string",
    "default": ""
  },
  "ai_base_url": {
    "description": "AI Base URL（OpenAI 兼容，如 https://api.opencodego.com/v1，空则用全局）",
    "type": "string",
    "default": ""
  },
  "ai_model": {
    "description": "AI 模型ID（如 muse-spark-1.2 / gpt-4o-mini / qwen-turbo，空则用全局；可用 /模型列表 获取）",
    "type": "string",
    "default": ""
  }
}
